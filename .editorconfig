
[*.cs]
#### C# Formatting Rules ####
# New line preferences
csharp_new_line_before_open_brace = none
csharp_new_line_before_catch = false
csharp_new_line_before_finally = false
csharp_new_line_before_else = false
# `var` preferences
csharp_style_var_for_built_in_types = false:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = true:suggestion
# Pattern matching preferences
csharp_style_prefer_switch_expression = false:suggestion
# Code-block preferences
csharp_style_prefer_top_level_statements = false:warning
csharp_style_prefer_primary_constructors = false:silent
csharp_prefer_braces = when_multiline:suggestion
# Expression-bodied members
csharp_style_expression_bodied_methods = when_on_single_line:suggestion
csharp_style_expression_bodied_properties = when_on_single_line:suggestion

#### .NET Programming Conventions ####
# this. and Me. preferences
dotnet_style_qualification_for_field = true:suggestion
dotnet_style_qualification_for_property = true:suggestion
dotnet_style_qualification_for_method = true:suggestion
dotnet_style_qualification_for_event = true:suggestion
# Modifier preferences
dotnet_style_require_accessibility_modifiers = always:warning
# Field preferences
dotnet_style_readonly_field = true:warning
# Expression-level preferences
dotnet_style_namespace_match_folder = false
dotnet_style_prefer_collection_expression = false:suggestion
csharp_style_implicit_object_creation_when_type_is_apparent = true:suggestion
dotnet_style_object_initializer = true:suggestion
dotnet_style_collection_initializer = when_types_loosely_match:suggestion
dotnet_style_null_propagation = true:suggestion
# Organize Usings
dotnet_sort_system_directives_first = true

#### .NET Diagnostics ####
dotnet_diagnostic.CS1591.severity = silent
dotnet_diagnostic.IDE0005.severity = suggestion

# We are windows only, so make the compiler shut up about non-windows compatibility.
dotnet_diagnostic.CA1416.severity = silent

# CS8601: Possible null reference assignment.
dotnet_diagnostic.CS8601.severity = silent

# SYSLIB1045: Convert to 'GeneratedRegexAttribute'.
dotnet_diagnostic.SYSLIB1045.severity = silent
